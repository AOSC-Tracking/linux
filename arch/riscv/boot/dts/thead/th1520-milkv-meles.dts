/dts-v1/;

#include "th1520.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Milk-V Meles";
	compatible = "milkv,meles", "thead,th1520";

	aliases {
		ethernet0 = &gmac0;
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		gpio5 = &aogpio;
		mmc0 = &emmc;
		mmc1 = &sdio0;
		mmc2 = &sdio1;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	wifi_32k: clock-wifi-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		/* The module LPO input is supplied by PMIC_32K_OUT. */
	};

	connector-usb-a-1 {
		compatible = "usb-a-connector";
		vbus-supply = <&usb_vbus>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				usb_a_1_hs_ep: endpoint {
					remote-endpoint = <&hub_hs_port1_ep>;
				};
			};

			port@1 {
				reg = <1>;

				usb_a_1_ss_ep: endpoint {
					remote-endpoint = <&hub_ss_port1_ep>;
				};
			};
		};
	};

	connector-usb-a-2 {
		compatible = "usb-a-connector";
		vbus-supply = <&usb_vbus>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				usb_a_2_hs_ep: endpoint {
					remote-endpoint = <&hub_hs_port2_ep>;
				};
			};

			port@1 {
				reg = <1>;

				usb_a_2_ss_ep: endpoint {
					remote-endpoint = <&hub_ss_port2_ep>;
				};
			};
		};
	};

	connector-usb-a-3 {
		compatible = "usb-a-connector";
		vbus-supply = <&usb_vbus>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				usb_a_3_hs_ep: endpoint {
					remote-endpoint = <&hub_hs_port3_ep>;
				};
			};

			port@1 {
				reg = <1>;

				usb_a_3_ss_ep: endpoint {
					remote-endpoint = <&hub_ss_port3_ep>;
				};
			};
		};
	};

	connector-usb-a-4 {
		compatible = "usb-a-connector";
		vbus-supply = <&usb_vbus>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				usb_a_4_hs_ep: endpoint {
					remote-endpoint = <&hub_hs_port4_ep>;
				};
			};

			port@1 {
				reg = <1>;

				usb_a_4_ss_ep: endpoint {
					remote-endpoint = <&hub_ss_port4_ep>;
				};
			};
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x2 0x0>;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pins>;
		pwms = <&pwm 2 10000000 0>;
		cooling-levels = <0 64 192 255>;
		#cooling-cells = <2>;
	};

	/* AVDD33_USB3 is supplied by the always-on DA9063 LDO9 rail. */
	avdd33_usb3: regulator-avdd33-usb3 {
		compatible = "regulator-fixed";
		regulator-name = "AVDD33_USB3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	usb_vbus: regulator-usb-vbus {
		/* U26 switches connector VBUS, not the GL3523 core supplies. */
		compatible = "regulator-fixed";
		regulator-name = "USB_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 27 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_vbus_pins>;
		/* Adopt the firmware's high enable level without a low pulse. */
		regulator-boot-on;
		regulator-always-on;
	};

	/* GL3523 core power; independent of the connector VBUS switch. */
	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	wifi_vbat: regulator-wifi-vbat {
		compatible = "regulator-fixed";
		regulator-name = "WIFI_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	wifi_vddio: regulator-wifi-vddio {
		compatible = "regulator-fixed";
		regulator-name = "WIFI_VDDIO";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_pins>;
		reset-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <50>;
	};
};

/* Names follow the 40-pin header signal labels. */
&aogpio {
	gpio-line-names = "", "", "", "", "", "", "", "AOGPIO_7",
			  "AOGPIO_8", "", "AOGPIO_10", "AOGPIO_11";
};

&dpu {
	status = "okay";
};

&emmc {
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	non-removable;
	no-sdio;
	no-sd;

	status = "okay";
};

&gmac0 {
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_pins>, <&mdio0_pins>;
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";

	status = "okay";
};

&gpio0 {
	gpio-line-names = "", "", "", "", "", "", "", "", "GPIO0_8",
			  "GPIO0_9", "GPIO0_10", "GPIO0_11", "", "", "",
			  "", "GPIO0_16", "GPIO0_17";
};

&gpio1 {
	/* GPIO1_24 low selects the external antenna through U39. */
	wifi-antenna-select-hog {
		gpio-hog;
		gpios = <24 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "wifi-external-antenna";
	};
};

&gpio2 {
	gpio-line-names = "GPIO2_0", "GPIO2_1", "", "", "", "", "", "",
			  "", "", "", "GPIO2_11", "GPIO2_12", "",
			  "GPIO2_14", "GPIO2_15", "GPIO2_16", "GPIO2_17",
			  "", "", "", "", "GPIO2_22", "GPIO2_23",
			  "GPIO2_24", "GPIO2_25", "", "", "", "", "",
			  "GPIO2_31";

	/* Vendor wiring, verified on Meles V1.3: low selects the GL3523. */
	usb-hub-select-hog {
		gpio-hog;
		gpios = <30 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "usb-hub-select";
	};
};

&gpio3 {
	gpio-line-names = "GPIO3_0", "GPIO3_1", "GPIO3_2", "GPIO3_3";
};

&hdmi {
	status = "okay";
};

&hdmi_out_port {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&mdio0 {
	phy0: ethernet-phy@1 {
		reg = <1>;
	};
};

&osc {
	clock-frequency = <24000000>;
};

&osc_32k {
	clock-frequency = <32768>;
};

&padctrl0_apsys {
	fan_pins: fan-0 {
		pwm2-pins {
			pins = "QSPI0_CSN1";
			function = "pwm";
			bias-disable;
			drive-strength = <25>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};

	gmac0_pins: gmac0-0 {
		tx-pins {
			pins = "GMAC0_TX_CLK",
			       "GMAC0_TXEN",
			       "GMAC0_TXD0",
			       "GMAC0_TXD1",
			       "GMAC0_TXD2",
			       "GMAC0_TXD3";
			function = "gmac0";
			bias-disable;
			drive-strength = <25>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		rx-pins {
			pins = "GMAC0_RX_CLK",
			       "GMAC0_RXDV",
			       "GMAC0_RXD0",
			       "GMAC0_RXD1",
			       "GMAC0_RXD2",
			       "GMAC0_RXD3";
			function = "gmac0";
			bias-disable;
			drive-strength = <1>;
			input-enable;
			input-schmitt-disable;
			slew-rate = <0>;
		};
	};

	mdio0_pins: mdio0-0 {
		mdc-pins {
			pins = "GMAC0_MDC";
			function = "gmac0";
			bias-disable;
			drive-strength = <13>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		mdio-pins {
			pins = "GMAC0_MDIO";
			function = "gmac0";
			bias-disable;
			drive-strength = <13>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	sdio0_pins: sdio0-0 {
		detn-pins {
			pins = "SDIO0_DETN";
			function = "sdio";
			bias-disable; /* external pull-up */
			drive-strength = <1>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};

	uart0_pins: uart0-0 {
		tx-pins {
			pins = "UART0_TXD";
			function = "uart";
			bias-disable;
			drive-strength = <3>;
			input-disable;
			input-schmitt-disable;
			slew-rate = <0>;
		};

		rx-pins {
			pins = "UART0_RXD";
			function = "uart";
			bias-disable;
			drive-strength = <1>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
	};
};

&padctrl1_apsys {
	usb_vbus_pins: usb-vbus-0 {
		usb-pins {
			pins = "GPIO0_27";
			/* The regulator's GPIO request selects the pin mux. */
			bias-disable;
			drive-strength = <7>;
			input-disable;
		};
	};

	wifi_enable_pins: wifi-enable-0 {
		gpio-pins {
			pins = "GPIO0_20";
			bias-disable;
			drive-strength = <7>;
			input-disable;
		};
	};

	wifi_host_wake_pins: wifi-host-wake-0 {
		gpio-pins {
			pins = "GPIO0_21";
			function = "gpio";
			bias-disable;
			input-enable;
			input-schmitt-enable;
		};
	};
};

&sdio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdio0_pins>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	no-1-8-v;
	disable-wp;
	no-sdio;

	status = "okay";
};

&sdio1 {
	bus-width = <4>;
	max-frequency = <198000000>;
	cap-sd-highspeed;
	cap-sdio-irq;
	non-removable;
	no-sd;
	no-mmc;
	keep-power-in-suspend;
	vmmc-supply = <&wifi_vbat>;
	vqmmc-supply = <&wifi_vddio>;
	mmc-pwrseq = <&wifi_pwrseq>;
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	wifi@1 {
		compatible = "brcm,bcm43456-fmac", "brcm,bcm4329-fmac";
		reg = <1>;
		clocks = <&wifi_32k>;
		clock-names = "lpo";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_pins>;
		interrupt-parent = <&gpio0>;
		interrupts = <21 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;

	status = "okay";
};

/* RESETn is an RC circuit; neither companion hub has a reset GPIO. */
&usb {
	dr_mode = "host";
	snps,dis_u2_susphy_quirk;
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	hub_hs: hub@1 {
		compatible = "usb5e3,610";
		reg = <1>;
		peer-hub = <&hub_ss>;
		vdd-supply = <&vcc_3v3>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				hub_hs_port1_ep: endpoint {
					remote-endpoint = <&usb_a_1_hs_ep>;
				};
			};

			port@2 {
				reg = <2>;

				hub_hs_port2_ep: endpoint {
					remote-endpoint = <&usb_a_2_hs_ep>;
				};
			};

			port@3 {
				reg = <3>;

				hub_hs_port3_ep: endpoint {
					remote-endpoint = <&usb_a_3_hs_ep>;
				};
			};

			port@4 {
				reg = <4>;

				hub_hs_port4_ep: endpoint {
					remote-endpoint = <&usb_a_4_hs_ep>;
				};
			};
		};
	};

	hub_ss: hub@2 {
		compatible = "usb5e3,620";
		reg = <2>;
		peer-hub = <&hub_hs>;
		vdd-supply = <&vcc_3v3>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				hub_ss_port1_ep: endpoint {
					remote-endpoint = <&usb_a_1_ss_ep>;
				};
			};

			port@2 {
				reg = <2>;

				hub_ss_port2_ep: endpoint {
					remote-endpoint = <&usb_a_2_ss_ep>;
				};
			};

			port@3 {
				reg = <3>;

				hub_ss_port3_ep: endpoint {
					remote-endpoint = <&usb_a_3_ss_ep>;
				};
			};

			port@4 {
				reg = <4>;

				hub_ss_port4_ep: endpoint {
					remote-endpoint = <&usb_a_4_ss_ep>;
				};
			};
		};
	};
};

&usb_phy {
	avdd33-usb3-supply = <&avdd33_usb3>;

	status = "okay";
};
